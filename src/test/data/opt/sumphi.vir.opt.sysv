module sumphi

function $sum(l %1/rdi) {
  %0 = slot 8, align 8
@2:
  st.l %1, %0 ; @24
  %42 = ld.w %0 ; @4
  %43 = add.l %0, 0x4_l ; @19
  %44 = ld.w %43 ; @6
  %45 = add.w %42, %44 ; @20
  ret rax/%45
}

export function $sumphi(l %8/rdi, l %9/rsi, w %11/rdx) {
@8:
  %51 = slt.w %11, 0x0_w ; @21
  br %51, @9, @10
@9:
  jmp @14(%8)
@10:
  jmp @14(%9)
@14(%52):
  tailcall $sum(%52/rdi)
}
