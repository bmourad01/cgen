module spill_slot_size

export function l $sized(w %n) {
@start:
  %i00 = copy.w 0_w
  %i01 = copy.w 1_w
  %i02 = copy.w 2_w
  %i03 = copy.w 3_w
  %i04 = copy.w 4_w
  %i05 = copy.w 5_w
  %i06 = copy.w 6_w
  %i07 = copy.w 7_w
  %i08 = copy.w 8_w
  %i09 = copy.w 9_w
  %s00 = copy.l 0x0101010100000000_l
  %s01 = copy.l 0x0202020200000000_l
  %s02 = copy.l 0x0303030300000000_l
  %s03 = copy.l 0x0404040400000000_l
  %s04 = copy.l 0x0505050500000000_l
  %s05 = copy.l 0x0606060600000000_l
  %s06 = copy.l 0x0707070700000000_l
  %s07 = copy.l 0x0808080800000000_l
  %s08 = copy.l 0x0909090900000000_l
  %s09 = copy.l 0x0a0a0a0a00000000_l
  %s10 = copy.l 0x0b0b0b0b00000000_l
  %s11 = copy.l 0x0c0c0c0c00000000_l
  %s12 = copy.l 0x0d0d0d0d00000000_l
  %s13 = copy.l 0x0e0e0e0e00000000_l
  %s14 = copy.l 0x0f0f0f0f00000000_l
  %s15 = copy.l 0x1010101000000000_l
  %s16 = copy.l 0x1111111100000000_l
  %s17 = copy.l 0x1212121200000000_l
  %s18 = copy.l 0x1313131300000000_l
  %s19 = copy.l 0x1414141400000000_l
  %s20 = copy.l 0x1515151500000000_l
  %s21 = copy.l 0x1616161600000000_l
  %s22 = copy.l 0x1717171700000000_l
  %s23 = copy.l 0x1818181800000000_l
  jmp @loop
@loop:
  %x00 = zext.l %i00
  %x01 = zext.l %i01
  %x02 = zext.l %i02
  %x03 = zext.l %i03
  %x04 = zext.l %i04
  %x05 = zext.l %i05
  %x06 = zext.l %i06
  %x07 = zext.l %i07
  %x08 = zext.l %i08
  %x09 = zext.l %i09
  %o00 = mul.l %x00, 24_l
  %o01 = mul.l %x01, 32_l
  %o02 = mul.l %x02, 40_l
  %o03 = mul.l %x03, 48_l
  %o04 = mul.l %x04, 56_l
  %o05 = mul.l %x05, 64_l
  %o06 = mul.l %x06, 72_l
  %o07 = mul.l %x07, 80_l
  %o08 = mul.l %x08, 88_l
  %o09 = mul.l %x09, 96_l
  %s00 = add.l %s00, %o00
  %s01 = add.l %s01, 2_l
  %s02 = add.l %s02, 3_l
  %s03 = add.l %s03, %o03
  %s04 = add.l %s04, 5_l
  %s05 = add.l %s05, 6_l
  %s06 = add.l %s06, %o06
  %s07 = add.l %s07, 8_l
  %s08 = add.l %s08, 9_l
  %s09 = add.l %s09, %o09
  %s10 = add.l %s10, 11_l
  %s11 = add.l %s11, 12_l
  %s12 = add.l %s12, %o02
  %s13 = add.l %s13, 14_l
  %s14 = add.l %s14, 15_l
  %s15 = add.l %s15, %o05
  %s16 = add.l %s16, 17_l
  %s17 = add.l %s17, 18_l
  %s18 = add.l %s18, %o08
  %s19 = add.l %s19, 20_l
  %s20 = add.l %s20, 21_l
  %s21 = add.l %s21, %o01
  %s22 = add.l %s22, 23_l
  %s23 = add.l %s23, 24_l
  %s00 = add.l %s00, %x00
  %s01 = add.l %s01, %x01
  %s02 = add.l %s02, %x02
  %s03 = add.l %s03, %x03
  %s04 = add.l %s04, %x04
  %s05 = add.l %s05, %x05
  %s06 = add.l %s06, %x06
  %s07 = add.l %s07, %x07
  %s08 = add.l %s08, %x08
  %s09 = add.l %s09, %x09
  %i00 = add.w %i00, 1_w
  %i01 = add.w %i01, 1_w
  %i02 = add.w %i02, 1_w
  %i03 = add.w %i03, 1_w
  %i04 = add.w %i04, 1_w
  %i05 = add.w %i05, 1_w
  %i06 = add.w %i06, 1_w
  %i07 = add.w %i07, 1_w
  %i08 = add.w %i08, 1_w
  %i09 = add.w %i09, 1_w
  %c = lt.w %i00, %n
  br %c, @loop, @end
@end:
  %acc = add.l %s00, %s01
  %acc = add.l %acc, %s02
  %acc = add.l %acc, %s03
  %acc = add.l %acc, %s04
  %acc = add.l %acc, %s05
  %acc = add.l %acc, %s06
  %acc = add.l %acc, %s07
  %acc = add.l %acc, %s08
  %acc = add.l %acc, %s09
  %acc = add.l %acc, %s10
  %acc = add.l %acc, %s11
  %acc = add.l %acc, %s12
  %acc = add.l %acc, %s13
  %acc = add.l %acc, %s14
  %acc = add.l %acc, %s15
  %acc = add.l %acc, %s16
  %acc = add.l %acc, %s17
  %acc = add.l %acc, %s18
  %acc = add.l %acc, %s19
  %acc = add.l %acc, %s20
  %acc = add.l %acc, %s21
  %acc = add.l %acc, %s22
  %acc = add.l %acc, %s23
  ret %acc
}
