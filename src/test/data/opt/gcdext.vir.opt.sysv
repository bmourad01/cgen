module gcdext

export function $gcd(w %3/rdi, w %4/rsi) {
  %67 = slot 8, align 8
  %70 = slot 8, align 8
  %72 = slot 8, align 8
@2:
  %76 = eq.w %3, 0x0_w ; @30
  br %76, @3, @4
@3:
  st.w %4, %67 ; @6
  %83 = add.l %67, 0x4_l ; @73
  st.w 0x0_w, %83 ; @8
  %85 = ld.l %67 ; @37
  st.w 0x1_w, %70 ; @42
  st.w 0x1_w, %72 ; @66
  jmp @29(%85)
@4:
  %95 = rem.w %4, %3 ; @12
  %96/l/rax, %97/l/rdx = call $gcd(%95/rdi, %3/rsi) ; @13
  st.l %97, %70 ; @60
  st.l %96, %67 ; @44
  %102 = ld.w %70 ; @46
  %107 = add.l %67, 0x4_l ; @74
  %108 = ld.w %107 ; @17
  %111 = div.w %4, %3 ; @21
  %112 = mul.w %111, %108 ; @35
  %113 = sub.w %102, %112 ; @36
  st.w %113, %107 ; @25
  %116 = ld.l %67 ; @49
  st.w %108, %70 ; @54
  st.w %108, %72 ; @72
  jmp @29(%116)
@29(%79):
  %82 = ld.l %72 ; @57
  ret rax/%79, rdx/%82
}
